new_no2 %>%
group_by(place) %>%
filter(!is.na(no2)) %>%
summarise(mean_no2 = mean(no2)) %>%
ggplot(aes(x = place, y = mean_no2, fill = place)) +
geom_bar(stat = "identity") +
xlab("Place") +
scale_fill_brewer(palette = "Dark2") +
theme(legend.position="bottom",
axis.text.x = element_blank(),
axis.ticks.x = element_blank())
rm(list = ls())
graphics.off()
